{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/signOffer", "function": "signOffer" },
      { "source": "/api/getOffer", "function": "getOffer" },
      { "source": "/api/signContract", "function": "signContract" },
      { "source": "/api/getContract", "function": "getContract" },
      { "source": "/api/analyzePdfTemplate", "function": "analyzePdfTemplate" },
      { "source": "/api/getPsychometricTest", "function": "getPsychometricTest" },
      { "source": "/api/submitPsychometricTest", "function": "submitPsychometricTest" },
      { "source": "/api/savePsychometricProgress", "function": "savePsychometricProgress" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=31536000" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "extensions": {}
}
