rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRecruiter() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/recruiters/$(request.auth.uid));
    }

    function recruiterData() {
      return get(/databases/$(database)/documents/recruiters/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isRecruiter() && recruiterData().role == 'admin';
    }

    // ─── Recruiters ───────────────────────────────────────────────────────────

    match /recruiters/{uid} {
      // Each user can read and write their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      // Admins can read all profiles (needed for Users management)
      allow read: if isAdmin();
      // Admins can update any profile (e.g. changing roles)
      allow update: if isAdmin();
    }

    // Gmail OAuth tokens — only Cloud Functions can read/write
    match /recruiters/{uid}/private/gmailTokens {
      allow read, write: if false;
    }

    // ─── Roles & Permissions ──────────────────────────────────────────────────

    match /roles/{roleId} {
      // Any authenticated recruiter can read role permissions (needed by useAuth)
      allow read: if isRecruiter();
      // Only admins can create or modify role permissions
      allow write: if isAdmin();
    }

    // ─── Candidates ───────────────────────────────────────────────────────────

    match /candidates/{candidateId} {
      // Recruiters can read and write all candidates
      allow read, write: if isRecruiter();

      // Candidates can read their own record via token (no auth needed)
      allow read: if resource.data.formToken != null;

      // Candidates can update their documents and questionnaire answers (no auth, identified by token).
      // completionPercentage and status are managed exclusively by Cloud Functions (backend).
      allow update: if
        resource.data.formToken != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['documents', 'formAnswers', 'updatedAt']);
    }

    // ─── Email Logs ───────────────────────────────────────────────────────────

    match /email_logs/{logId} {
      allow read: if isRecruiter();
      allow write: if false; // Only Cloud Functions write logs
    }

    // ─── Settings ─────────────────────────────────────────────────────────────

    match /settings/{docId} {
      allow read: if isRecruiter();
      allow write: if isAdmin();
    }

    // ─── Offer Templates ──────────────────────────────────────────────────────

    match /offer_templates/{templateId} {
      allow read: if isRecruiter();
      allow write: if isAdmin();
    }

    // ─── Contract Templates ───────────────────────────────────────────────────

    match /contract_templates/{templateId} {
      allow read: if isRecruiter();
      allow write: if isAdmin();
    }

    // ─── Viterbit Webhook Logs ────────────────────────────────────────────────

    match /viterbit_webhook_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
