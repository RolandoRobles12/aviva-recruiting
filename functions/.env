# Firebase Functions - Environment Variables
# Para producción: pon el mismo secreto que tienes en Viterbit → Webhooks → Secret
VITERBIT_WEBHOOK_SECRET=

# Stage de Viterbit que dispara el portal (nombre exacto como aparece en Viterbit)
HIRING_STAGE_NAME=Documentos

# URL del portal web
APP_URL=https://aviva-recruiting.web.app

# Vacantes permitidas (separadas por coma). Vacío = todas.
HIRING_JOB_NAMES=
